<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders assets/*.svg into the .ico/.png files the apps embed. Run "dotnet run (project) tools/IconGen" from the repo root. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>
</Project>
