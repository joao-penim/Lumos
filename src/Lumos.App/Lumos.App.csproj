<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Lumos</AssemblyName>
    <RootNamespace>Lumos.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\lumos.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The UI only runs while open; trimmed ReadyToRun keeps startup fast without AOT constraints on FluentAvalonia. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\lumos-256.png" Link="Assets\lumos-256.png" />
    <AvaloniaResource Include="..\..\assets\lumos.ico" Link="Assets\lumos.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumos.Core\Lumos.Core.csproj" />
    <ProjectReference Include="..\Lumos.Platform.Windows\Lumos.Platform.Windows.csproj" />
  </ItemGroup>
  <!-- Dev convenience: put LumosAgent.exe next to Lumos.exe so `dotnet run` works end to end. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\Lumos.Agent\Lumos.Agent.csproj" />
  </ItemGroup>
</Project>
