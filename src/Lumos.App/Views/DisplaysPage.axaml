<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumos.App.ViewModels"
             x:Class="Lumos.App.Views.DisplaysPage"
             x:DataType="vm:MainViewModel">
  <StackPanel Spacing="4">
    <TextBlock Classes="pageTitle" Text="Displays" Margin="0,0,0,4" />
    <TextBlock Classes="secondary" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Current HDR state of each connected display. Switching HDR here works like Win + Alt + B. If you turn off HDR that Lumos turned on, Lumos leaves it off." />

    <ItemsControl ItemsSource="{Binding Displays}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DisplayItemViewModel">
          <Border Classes="card">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
              <TextBlock Classes="glyph" Text="&#xE7F4;" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Name}" FontSize="14" />
                <TextBlock Classes="secondary" Text="{Binding Details}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding StateText}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="3" IsChecked="{Binding HdrEnabled}" IsEnabled="{Binding HdrSupported}"
                            OnContent="HDR" OffContent="SDR" VerticalAlignment="Center" MinWidth="0" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="secondary" Margin="2,12,0,0" IsVisible="{Binding !AgentRunning}"
               Text="Start the Lumos agent to see your displays." />
  </StackPanel>
</UserControl>
